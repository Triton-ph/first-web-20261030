e":24,"fontWeight":"700","color":"#0f172a","align":"left","lineHeight":"1.4","bgColor":"transparent","borderRadius":0,"opacity":100,"shadow":"none"}],"bgGradient":{"enabled":false,"color1":"#0284c7","color2":"#0f172a","direction":"to right","angle":90},"bgType":"color"}